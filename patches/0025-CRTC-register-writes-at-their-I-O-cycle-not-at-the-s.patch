From a3c42809e0ec95c648407d13536fd41f3892ba91 Mon Sep 17 00:00:00 2001
From: John Stringer <jcec_1@yahoo.co.uk>
Date: Sat, 24 Oct 2026 13:02:21 +0100
Subject: [PATCH 25/34] CRTC: register writes at their I/O cycle, not at the
 start of the OUT

The CRTC was run after each whole Z80 instruction, so an OUT reached it at the
start of the instruction, 2-4 us before its I/O cycle on the CPC. Pinball
Dreams rewrites R0/R4/R5/R7/R9 several times a frame with 1-line rows; its R0
write landed before the end of the line it was meant to follow, HCC ran on to
255 and the frame lost sync (rolling picture, then a crash at ball launch).
Z80_IO_AT(n) before each OUT/IN: the host's CPC_IOCatchUp runs the CRTC to the
I/O cycle (CPCEC's NOP positions), the rest of the instruction afterwards.
Only CRTC register writes are timed by default; IOTIME_ALL times every port.
NO_IOTIME_FIX restores I/O at the start of the instruction.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/cpc/arnold.c       | 24 +++++++++++++++++++++++-
 src/cpc/cpc.c          | 23 +++++++++++++++++++++++
 src/cpc/z80/z80.c      | 36 ++++++++++++++++++------------------
 src/cpc/z80/z80.h      | 14 ++++++++++++++
 src/cpc/z80/z80funcs.h |  8 ++++----
 5 files changed, 82 insertions(+), 23 deletions(-)

diff --git a/src/cpc/arnold.c b/src/cpc/arnold.c
index 5afb114..13953e3 100644
--- a/src/cpc/arnold.c
+++ b/src/cpc/arnold.c
@@ -70,6 +70,24 @@ static int CurrentFrameIndex = 0;
 static int FrameSkip = FRAME_SKIP_MIN;
 /* number of nops executed in this frame so far */
 static int NopCountToDate = NOPS_PER_MONITOR_SCREEN;
+#ifndef NO_IOTIME_FIX
+/* Amiga port (Pinball Dreams, 20 Oct 2026): I/O at its own NOP within the
+ * instruction (z80.h Z80_IO_AT). CPC_IOPre: NOPs of the current instruction
+ * before its I/O cycle; CPC_IOAhead: NOPs of it the CRTC has already been run
+ * (the main loop then runs only the rest). Never past the frame end, so the
+ * frame-end path below is unchanged. */
+int CPC_IOPre, CPC_IOAhead;
+void CPC_IOCatchUp(void)
+{
+	int k = CPC_IOPre - CPC_IOAhead;
+	if (k > NopCountToDate - CPC_IOAhead) k = NopCountToDate - CPC_IOAhead;
+	CPC_IOPre = 0;
+	if (k > 0) { CRTC_DoCycles(k); CPC_IOAhead += k; }
+}
+#define IO_AHEAD_TAKE(n) do { (n) -= CPC_IOAhead; CPC_IOAhead = 0; } while (0)
+#else
+#define IO_AHEAD_TAKE(n) do { } while (0)
+#endif
 /* TRUE if audio is enabled, FALSE otherwise */
 static BOOL AudioActiveFlag = FALSE;
 /* TRUE if debugger is enabled, FALSE otherwise */
@@ -401,7 +419,7 @@ void	CPCEmulation_Run(void)
 			if (LocalNopCountToDate > 0)
 			{
 				/* Amiga port: a skipped frame before a drawn one: drawing on now */
-				CRTC_DoCycles(NopCount);
+				{ int n = NopCount; IO_AHEAD_TAKE(n); CRTC_DoCycles(n); }
 				RenderOnEarlyAt = 0;
 				if (Render_IsRendererActive())
 				{
@@ -413,6 +431,7 @@ void	CPCEmulation_Run(void)
 			}
 
 			NopsToFrameEnd = NopCount + LocalNopCountToDate;
+			IO_AHEAD_TAKE(NopsToFrameEnd);   /* CPC_IOCatchUp stops at the frame end */
 
 			/* update CRTC for NopCount cycles */
 			if (NopsToFrameEnd!=0)
@@ -533,6 +552,9 @@ void	CPCEmulation_Run(void)
 			/* Amiga port: quiet cycles short of the next CRTC event are only
 			 * counted here and drawn later (crtc.c CRTC_Pending) */
 			extern int CRTC_RunLeft, CRTC_Pending, ASIC_DMA_IntPending;
+#endif
+			IO_AHEAD_TAKE(NopCount);   /* NopCount is not used again below */
+#if !defined(NO_DEFER) && !defined(NO_E)
 			if (NopCount < CRTC_RunLeft && !ASIC_DMA_IntPending)
 			{
 				CRTC_RunLeft -= NopCount;
diff --git a/src/cpc/cpc.c b/src/cpc/cpc.c
index f088816..e891f71 100644
--- a/src/cpc/cpc.c
+++ b/src/cpc/cpc.c
@@ -2728,8 +2728,28 @@ void	KCCompact_Out(Z80_WORD Port, Z80_BYTE Data)
 
 /* Write data to a I/O port */
 void CRTC_InvalidateRun(void);   /* Amiga port: crtc.c run-based stepping */
+#ifndef NO_IOTIME_FIX
+void CPC_IOCatchUp(void);   /* arnold.c: run the CRTC to the I/O cycle (z80.h Z80_IO_AT) */
+/* Which accesses are timed. Default: only writes to a CRTC register (A14 = 0,
+ * A9 = 0, A8 = 1: &BDxx), the case Pinball Dreams needs (R0 rewritten just after
+ * a line ends). This keeps Sonic GX frame-identical; other games can change where
+ * a CRTC write fell within 3 us of a CRTC event (e.g. the boot's first R0 write
+ * sets a slightly different CPU/CRTC phase). IOTIME_ALL (define): every OUT and
+ * IN, as on the CPC (CPCEC): also straightens Burnin' Rubber's title bars, but
+ * moves raster lines at the left edge in Sonic GX; not evaluated further yet. */
+#ifdef IOTIME_ALL
+#define IOTIME_PORT_OUT(p) 1
+#define IOTIME_PORT_IN(p) 1
+#else
+#define IOTIME_PORT_OUT(p) (((p) & 0x4300) == 0x0100)
+#define IOTIME_PORT_IN(p) 0
+#endif
+#endif
 void    Z80_DoOut(Z80_WORD Port,Z80_BYTE Data)
 {
+#ifndef NO_IOTIME_FIX
+	if (IOTIME_PORT_OUT(Port)) CPC_IOCatchUp();
+#endif
 	/* Amiga port: an OUT that reaches the CRTC (A14 = 0) or the Gate Array
 	 * (A15 = 0: pens, mode, ROM/RAM and ASIC paging) may change what the CRTC
 	 * draws next; PPI/PSG, FDC and printer writes cannot. */
@@ -3070,6 +3090,9 @@ Z80_BYTE        KCCompact_In(Z80_WORD Port)
 
 Z80_BYTE        Z80_DoIn(Z80_WORD Port)
 {
+#ifndef NO_IOTIME_FIX
+	if (IOTIME_PORT_IN(Port)) CPC_IOCatchUp();
+#endif
 	if (CRTC_Pending) CRTC_Flush();   /* crtc.c deferred cells: the CRTC is up to date for reads */
 	switch (CPC_GetHardware())
 	{
