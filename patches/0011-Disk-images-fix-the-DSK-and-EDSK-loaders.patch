From 850d488e0d65c5b7ceba7b11be36e6581ada5cf3 Mon Sep 17 00:00:00 2001
From: John Stringer <jcec_1@yahoo.co.uk>
Date: Thu, 29 Oct 2026 20:01:06 +0000
Subject: [PATCH 11/42] Disk images: fix the DSK and EDSK loaders

EDSK: the loader stepped and copied each sector by the larger of its stored
length and its ID's size (N), so a short sector, such as the common N=6
protection holding 6144 bytes, read past the image buffer (AddressSanitizer)
and every later sector of the track got the wrong data. It now steps by the
stored length and clamps the copy. Tracks with more than 29 sectors use a
512-byte track header, as CPCEC writes them.
Standard DSK: every sector occupies the track header's sector size (as CPCEC),
not its ID's size. Also an off-by-one in the sector index check, pointers left
dangling after a format, and a leftover debug printf in FDC_BeginSeek.
Checked with generated test disks (odd sizes, gaps, weak and deleted sectors,
42 tracks, two sides) and 13 real disks against CPCEC. NO_DSK_FIX restores the
old loaders.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/cpc/diskimage/iextdsk.c | 111 +++++++++++++++++++++++++++++++++++-
 src/cpc/fdc.c               |   2 +
 2 files changed, 111 insertions(+), 2 deletions(-)

diff --git a/src/cpc/diskimage/iextdsk.c b/src/cpc/diskimage/iextdsk.c
index 9ebc35c..ec17d0d 100644
--- a/src/cpc/diskimage/iextdsk.c
+++ b/src/cpc/diskimage/iextdsk.c
@@ -33,6 +33,25 @@ static int	GetSectorSize(int N)
     return (1<<(N&0x07))<<7;
 }
 
+#ifndef NO_DSK_FIX
+#ifndef min
+#define min(a,b) ((a<b) ? a : b )
+#endif
+/* Amiga port (disk-image fix): copy up to nBytes of a sector's stored data,
+ * never past the end of its track or of the loaded image; what is not copied
+ * keeps the filler byte AddSectorToTrack put there. */
+static void DskFix_CopySector(char *pDest, const char *pSrc, int nBytes, const char *pTrackEnd, const char *pImageEnd)
+{
+	const char *pEnd = pTrackEnd < pImageEnd ? pTrackEnd : pImageEnd;
+
+	if (pDest == NULL || nBytes <= 0 || pSrc >= pEnd)
+		return;
+	if (nBytes > pEnd - pSrc)
+		nBytes = (int)(pEnd - pSrc);
+	memcpy(pDest, pSrc, nBytes);
+}
+#endif
+
 /* create a new one ready for use */
 EXTDSK_INTERNAL *ExtDskInternal_New(void)
 {
@@ -151,6 +170,9 @@ void	ExtDskInternal_RemoveSectorsInTrack(EXTDSK_INTERNAL *pExtDsk, int TrackInde
 					if (pTrack->pSectorData[i]!=NULL)
 					{
 						free(pTrack->pSectorData[i]);
+#ifndef NO_DSK_FIX
+						pTrack->pSectorData[i] = NULL;   /* Amiga port (disk-image fix): no stale pointers after a format */
+#endif
 					}
 				}
 
@@ -220,8 +242,14 @@ char *ExtDskInternal_GetPointerToSectorData(EXTDSK_INTERNAL *pExtDsk, int TrackI
                                 /* get pointer to track */
                                 pTrack = pExtDsk->pTrackList[TrackIndex];
 
+#ifndef NO_DSK_FIX
+                                /* Amiga port (disk-image fix): index == NoOfSectors is past the end too */
+                                if (SectorIndex<0 || pTrack->NoOfSectors<=SectorIndex)
+                                        return NULL;
+#else
                                 if (pTrack->NoOfSectors<SectorIndex)
                                         return NULL;
+#endif
 
                                 return pTrack->pSectorData[SectorIndex];
                         }
@@ -926,6 +954,35 @@ void            ExtDskInternal_Dsk2ExtDskInternal(DISKIMAGE_UNIT *pUnit, const u
 
                                 ExtDskInternal_AddTrack(pExtDsk, TrackIndex);
 
+#ifndef NO_DSK_FIX
+                                /* Amiga port (disk-image fix): in a standard DSK every sector
+                                 * occupies the track header's size (BPS); the original stepped
+                                 * and copied by each ID's own N, so an ID with a different N
+                                 * (a common protection) got the wrong data, shifted the rest of
+                                 * the track and could read past the image. Copy the stored
+                                 * bytes (the rest of a bigger ID stays filler) and keep to the
+                                 * 29 IDs a 256-byte track header holds. */
+                                for (j=0; j<pTrack->SPT && j<29; j++)
+                                {
+                                        EXTDSKCHRN LocalCHRN;
+                                        int Stride = GetSectorSize(pTrack->BPS);
+                                        int SectorSize = GetSectorSize(pTrack->SectorIDs[j].N);
+
+                                        LocalCHRN.C = pTrack->SectorIDs[j].C;
+                                        LocalCHRN.H = pTrack->SectorIDs[j].H;
+                                        LocalCHRN.R = pTrack->SectorIDs[j].R;
+                                        LocalCHRN.N = pTrack->SectorIDs[j].N;
+                                        LocalCHRN.ST1 = pTrack->SectorIDs[j].ST1;
+                                        LocalCHRN.ST2 = pTrack->SectorIDs[j].ST2;
+
+                                        ExtDskInternal_AddSectorToTrack(pExtDsk, TrackIndex, &LocalCHRN,pTrack->FillerByte,SectorSize);
+
+                                        DskFix_CopySector(ExtDskInternal_GetPointerToSectorData(pExtDsk, TrackIndex, j),
+                                                (const char *)pTrack + sizeof(DSKTRACKHEADER) + Stride*j,
+                                                min(Stride, SectorSize), (const char *)pTrack + TrackSize,
+                                                (const char *)pDiskImage + DiskImageSize);
+                                }
+#else
                                 for (j=0; j<pTrack->SPT; j++)
                                 {
                                         char *Sector;
@@ -945,10 +1002,11 @@ void            ExtDskInternal_Dsk2ExtDskInternal(DISKIMAGE_UNIT *pUnit, const u
                                         pSectorData = ExtDskInternal_GetPointerToSectorData(pExtDsk, TrackIndex, j);
 
                                         Sector = (char *)pTrack + sizeof(DSKTRACKHEADER) + SectorSize*j;
-          
+
 										memcpy(pSectorData, Sector, SectorSize);
                                 }
-                                
+#endif
+
                                 pTrack = (DSKTRACKHEADER *)((uintptr_t)pTrack + TrackSize);
                         }
                 }
@@ -998,6 +1056,54 @@ void            ExtDskInternal_ExtDsk2ExtDskInternal(DISKIMAGE_UNIT *pUnit, cons
 
                                         ExtDskInternal_AddTrack(pExtDsk, TrackIndex);
 
+#ifndef NO_DSK_FIX
+                                        /* Amiga port (disk-image fix): step by the length the
+                                         * image stores for each sector (0 in old images = the
+                                         * ID's size) and copy only that, inside this track and
+                                         * the image. The original stepped and copied by
+                                         * max(stored, ID size), so a short sector (e.g. N=6 with
+                                         * 6144 bytes, a common protection) read past its data and
+                                         * shifted every later sector on the track. Tracks with
+                                         * more than 29 sectors have a 512-byte header (as CPCEC
+                                         * and SAMdisk write them); 61 IDs fit in that. */
+                                        {
+                                                int nSPT = pTrack->SPT;
+                                                const char *pTrackEnd = (const char *)pTrack + ((pHeader->TrackSizeTable[i] & 0x0ff)<<8);
+                                                const char *pImageEnd = (const char *)pDiskImage + DiskImageSize;
+
+                                                if (nSPT > 29)
+                                                {
+                                                        if (nSPT > 61) nSPT = 61;
+                                                        Sector = (char *)pTrack + 512;
+                                                }
+
+                                                for (j=0; j<nSPT; j++)
+                                                {
+                                                        EXTDSKCHRN LocalCHRN;
+                                                        int SectorSizeFromID = GetSectorSize(pTrack->SectorIDs[j].N);
+                                                        int SectorSizeFromDSK = (pTrack->SectorIDs[j].SectorSizeLow & 0x0ff) |
+                                                                ((pTrack->SectorIDs[j].SectorSizeHigh & 0x0ff)<<8);
+
+                                                        if (SectorSizeFromDSK == 0)
+                                                                SectorSizeFromDSK = SectorSizeFromID;
+
+                                                        LocalCHRN.C = pTrack->SectorIDs[j].C;
+                                                        LocalCHRN.H = pTrack->SectorIDs[j].H;
+                                                        LocalCHRN.R = pTrack->SectorIDs[j].R;
+                                                        LocalCHRN.N = pTrack->SectorIDs[j].N;
+                                                        LocalCHRN.ST1 = pTrack->SectorIDs[j].ST1;
+                                                        LocalCHRN.ST2 = pTrack->SectorIDs[j].ST2;
+
+                                                        ExtDskInternal_AddSectorToTrack(pExtDsk, TrackIndex, &LocalCHRN, pTrack->FillerByte,
+                                                                max(SectorSizeFromDSK, SectorSizeFromID));
+
+                                                        DskFix_CopySector(ExtDskInternal_GetPointerToSectorData(pExtDsk, TrackIndex, j),
+                                                                Sector, SectorSizeFromDSK, pTrackEnd, pImageEnd);
+
+                                                        Sector += SectorSizeFromDSK;
+                                                }
+                                        }
+#else
                                         for (j=0; j<pTrack->SPT; j++)
                                         {
                                                 EXTDSKCHRN LocalCHRN;
@@ -1027,6 +1133,7 @@ void            ExtDskInternal_ExtDsk2ExtDskInternal(DISKIMAGE_UNIT *pUnit, cons
                                                 Sector += nAllocationSize;
 
                                         }
+#endif
 
                                         pTrack = (EXTDSKTRACKHEADER *)((uintptr_t)pTrack + ((pHeader->TrackSizeTable[i] & 0x0ff)<<8));
                                 }
diff --git a/src/cpc/fdc.c b/src/cpc/fdc.c
index 80ea5d1..03127cd 100644
--- a/src/cpc/fdc.c
+++ b/src/cpc/fdc.c
@@ -341,10 +341,12 @@ void	FDC_BeginSeek(void)
 		/* new cylinder number */
 		fdc.NCN = fdc.CommandBytes[2] & 0x0ff;
 
+#ifdef NO_DSK_FIX
         if (fdc.NCN==0x05)
         {
             printf("Here");
         }
+#endif
 
 		/* set seek direction */
 		if (PCN<fdc.NCN)
