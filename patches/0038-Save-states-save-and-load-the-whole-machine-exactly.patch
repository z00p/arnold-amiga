diff --git a/src/cpc/arnold.c b/src/cpc/arnold.c
index af15078..5596a87 100644
--- a/src/cpc/arnold.c
+++ b/src/cpc/arnold.c
@@ -627,3 +627,26 @@ BOOL	CPCEmulation_CheckEndianness(void)
 #endif
 	return EndianCorrect;
 }
+
+#ifndef NO_SAVESTATE
+/* Amiga port (save states, 28 Oct 2026): the main loop's state between two
+ * CPCEmulation_Run calls (cpc/savestate.c). FrameSkip and the skip hook are the
+ * host's; the I/O lead is stored as 0 in a NO_IOTIME_FIX build (same stream). */
+#include "savestate.h"
+void SS_Arnold(SS_IO *io)
+{
+	int pre = 0, ahead = 0;
+#ifndef NO_IOTIME_FIX
+	pre = CPC_IOPre; ahead = CPC_IOAhead;
+#endif
+	SS_V(io, NopCountToDate); SS_V(io, RenderOnEarlyAt); SS_V(io, DontRender);
+	SS_V(io, FrameMeantToRender); SS_V(io, RenderNextFrame); SS_V(io, CurrentFrameIndex);
+	SS_V(io, pre); SS_V(io, ahead);
+	if (io->load) {
+#ifndef NO_IOTIME_FIX
+		CPC_IOPre = pre; CPC_IOAhead = ahead;
+#endif
+		if (CurrentFrameIndex > FrameSkip) CurrentFrameIndex = 0;   /* another frame skip set now */
+	}
+}
+#endif
diff --git a/src/cpc/asic.c b/src/cpc/asic.c
index fa8455b..5f8a77d 100644
--- a/src/cpc/asic.c
+++ b/src/cpc/asic.c
@@ -2613,3 +2613,83 @@ void	ASIC_UpdateColours(void)
     }
 }
 
+
+#ifdef NO_DMA_STAGGER
+int ASIC_DMA_IntPending;   /* always 0: arnold.c's deferral reads it (NO_DMA_STAGGER did not link before; here at the end so no line above moves: PGO) */
+#endif
+
+#ifndef NO_SAVESTATE
+/* Amiga port (save states, 28 Oct 2026): the ASIC for cpc/savestate.c. The RAM
+ * paging mask is stored as on/off (it is a pointer mask); the sprite column and
+ * line caches are rebuilt on first use after a load. The cartridge itself is not
+ * stored: ASIC_CartCrc identifies it (its blocks and how the 32 pages use them). */
+#include "savestate.h"
+unsigned long ASIC_CartCrc(void)
+{
+	unsigned long crc = 0;
+	unsigned char map[32];
+	int i, j;
+	if (NumCartridgeBlocks == 0) return 0;
+	for (i = 0; i < (int)NumCartridgeBlocks && i < 32; i++)
+		if (CartridgeBlocks[i]) crc = SaveState_Crc32(crc, CartridgeBlocks[i], 16384);
+	for (i = 0; i < 32; i++) {
+		map[i] = 0x0ff;
+		for (j = 0; j < (int)NumCartridgeBlocks && j < 32; j++)
+			if (CartridgePages[i] == CartridgeBlocks[j]) { map[i] = (unsigned char)j; break; }
+	}
+	crc = SaveState_Crc32(crc, map, 32);
+	return crc ? crc : 1;
+}
+
+void SS_Asic(SS_IO *io)
+{
+	ASIC_DATA *a = &ASIC_Data;
+	long rammask = a->ASIC_RamMask != 0;
+	int i, done = 0, d0 = 0, d1 = 0, d2 = 0, pend = 0, base = 0;
+	int stale = ASIC_SpriteMaskStale;   /* speed14: a state saved after an undrawn line keeps the rebuild due (crtc.c) */
+#ifndef NO_DMA_STAGGER
+	done = ASIC_DMA_Stagger.Done; d0 = ASIC_DMA_Stagger.Delay[0]; d1 = ASIC_DMA_Stagger.Delay[1]; d2 = ASIC_DMA_Stagger.Delay[2];
+	pend = ASIC_DMA_IntPending;
+#endif
+#ifndef NO_DMAPHASE
+	base = ASIC_DMA_PhaseBase;
+#endif
+	SS_V(io, a->Flags); rammask = SS_Long(io, rammask);
+	SS_V(io, a->SpriteEnableMask); SS_V(io, a->SpriteEnableMaskOnLine);
+	for (i = 0; i < 16; i++) {
+		SS_V(io, a->Sprites[i].SpriteX.SpriteX_W); SS_V(io, a->Sprites[i].SpriteY.SpriteY_W); SS_V(io, a->Sprites[i].SpriteMag);
+		SS_V(io, a->SpriteInfo[i].WidthInColumns); SS_V(io, a->SpriteInfo[i].MinColumn); SS_V(io, a->SpriteInfo[i].HeightInLines);
+		SS_V(io, a->SpriteInfo[i].XMagShift); SS_V(io, a->SpriteInfo[i].YMagShift);
+		SS_V(io, a->SpriteInfo[i].x); SS_V(io, a->SpriteInfo[i].y);
+	}
+	SS_V(io, a->DMAPauseActive);
+	for (i = 0; i < 3; i++) {
+		SS_V(io, a->DMA[i].Addr.Addr_W); SS_V(io, a->DMA[i].Prescale);
+		SS_V(io, a->DMAChannel[i].PauseActive); SS_V(io, a->DMAChannel[i].PauseCount);
+		SS_V(io, a->DMAChannel[i].PrescaleCount); SS_V(io, a->DMAChannel[i].LoopStart);
+		SS_V(io, a->DMAChannel[i].RepeatCount);
+	}
+	SS_V(io, a->ASIC_InterruptVector); SS_V(io, a->ASIC_RasterInterruptLine); SS_V(io, a->ASIC_SoftScroll);
+	SS_V(io, a->ASIC_RasterSplitLine); SS_V(io, a->ASIC_SecondaryScreenAddress.Addr_W); SS_V(io, a->InternalDCSR);
+	SS_V(io, a->ASIC_DCSR2); SS_V(io, a->SecondaryRomMapping); SS_A(io, a->AnalogueInputs);
+	SS_Pack(io, a->ASIC_Ram, 16384);
+	SS_V(io, RecogniseSequenceState); SS_V(io, CurrentSequencePos); SS_V(io, CurrentLine);
+	SS_V(io, done); SS_V(io, d0); SS_V(io, d1); SS_V(io, d2); SS_V(io, pend); SS_V(io, base);
+	SS_V(io, stale);
+	if (io->load && !io->err) {
+		a->ASIC_RamMask = rammask ? (unsigned long)~0UL : 0;
+#ifndef NO_DMA_STAGGER
+		ASIC_DMA_Stagger.Done = done; ASIC_DMA_Stagger.Delay[0] = d0; ASIC_DMA_Stagger.Delay[1] = d1; ASIC_DMA_Stagger.Delay[2] = d2;
+		ASIC_DMA_IntPending = pend;
+#endif
+#ifndef NO_DMAPHASE
+		ASIC_DMA_PhaseBase = base;
+#endif
+		ASIC_SpriteMaskStale = stale;
+		ASIC_ColMaskValid = 0;
+#ifndef NO_SPRLINE
+		ASIC_LineBufOK = 0;
+#endif
+	}
+}
+#endif
diff --git a/src/cpc/audioevent.c b/src/cpc/audioevent.c
index fea20d2..9bc8fad 100644
--- a/src/cpc/audioevent.c
+++ b/src/cpc/audioevent.c
@@ -1146,3 +1146,65 @@ void	AudioEvent_ConvertToOutputFormat_8BitStereo(char *pSrcBuffer, char *pDestBu
 	}
 }
 
+
+#ifndef NO_SAVESTATE
+/* Amiga port (save states, 28 Oct 2026): for cpc/savestate.c. The sample rate set-up
+ * (the float and fixed-point steps, the buffers) is the host's; what is kept is
+ * the event buffer (empty after each frame while sound is on; it fills up and
+ * stays full while sound is off), the fraction carried between frames and the
+ * Digiblaster's position (its block is only used by 8-bit output). Each event is
+ * stored as its NOP time, type and the two values (PSG register and data). */
+#include "savestate.h"
+void SS_Audio(SS_IO *io)
+{
+	long n = NoOfEventsInBuffer, dig = 0, max = pEventBuffer ? (long)(EventBufferLength / sizeof(AUDIO_EVENT)) : 0;
+	unsigned char *ev = NULL;
+	int i;
+	if (!io->load && Digiblaster_Buffer) dig = (long)(pDigiblaster_Data - Digiblaster_Buffer);
+	SS_V(io, NopCount.FixedPoint.L); SS_V(io, EventBufferNopCount); SS_V(io, AudioEvent_PreviousFraction);
+	SS_V(io, Digiblaster_PreviousData); SS_V(io, Digiblaster_CPCNopCountOfLastWrite); SS_V(io, Digiblaster_PreviousFraction);
+	SS_V(io, Digiblaster_Volume); SS_V(io, Tape_Volume); SS_V(io, Vol); SS_V(io, DAC_AudioActive);
+	SS_V(io, SamplesToGenerate);   /* NO_SNDLUT_FIX: still 0 for the first block after start-up */
+	dig = SS_Long(io, dig);
+	if (dig > 0 && !io->err) {
+		if (!Digiblaster_Buffer || dig > AudioBufSize) SS_Fail(io, "The state's Digiblaster data does not fit");
+		else SS_Raw(io, Digiblaster_Buffer, dig);
+	}
+	n = SS_Long(io, n);
+	if (io->err) return;
+	if (n < 0 || n > max) { SS_Fail(io, "The state's sound events do not fit"); return; }
+	if (n) {
+		ev = (unsigned char *)malloc(n * 11);
+		if (!ev) { SS_Fail(io, "Not enough memory for the sound events"); return; }
+		if (!io->load)
+			for (i = 0; i < n; i++) {
+				AUDIO_EVENT *e = (AUDIO_EVENT *)pEventBuffer + i;
+				unsigned long long t = e->NopCount;
+				unsigned char *p = ev + i * 11;
+				int k;
+				if (e->Type > 255 || e->AudioEvent.PSG_Event.PSG_Register > 255 || e->AudioEvent.PSG_Event.PSG_RegisterData > 255) SS_Fail(io, "Save state: a sound event out of range");
+				for (k = 7; k >= 0; k--) { p[k] = (unsigned char)t; t >>= 8; }
+				p[8] = (unsigned char)e->Type; p[9] = (unsigned char)e->AudioEvent.PSG_Event.PSG_Register;
+				p[10] = (unsigned char)e->AudioEvent.PSG_Event.PSG_RegisterData;
+			}
+		SS_Pack(io, ev, (unsigned long)n * 11);
+		if (io->load && !io->err)
+			for (i = 0; i < n; i++) {
+				AUDIO_EVENT *e = (AUDIO_EVENT *)pEventBuffer + i;
+				unsigned long long t = 0;
+				unsigned char *p = ev + i * 11;
+				int k;
+				for (k = 0; k < 8; k++) t = (t << 8) | p[k];
+				memset(e, 0, sizeof *e);
+				e->NopCount = (unsigned long)t; e->Type = p[8];
+				e->AudioEvent.PSG_Event.PSG_Register = p[9]; e->AudioEvent.PSG_Event.PSG_RegisterData = p[10];
+			}
+		free(ev);
+	}
+	if (io->load && !io->err) {
+		NoOfEventsInBuffer = (int)n;
+		pEventBufferPtr = pEventBuffer + n * sizeof(AUDIO_EVENT);
+		if (Digiblaster_Buffer) pDigiblaster_Data = Digiblaster_Buffer + (dig > 0 ? dig : 0);
+	}
+}
+#endif
