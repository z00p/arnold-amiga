+				((Z80MemoryBase[(unsigned long)(Addr)])<<8) | (Z80MemoryBase[(unsigned long)(Addr+1)]);
+		}
+		return;
+	}
+#endif
+
 	/* do draw */
 	CRTC_SetRenderingFunction();
 
+#ifndef NO_D
+	/* Amiga port D: the common cells without any function call. Each branch
+	 * does exactly what the paletted function it replaces does. */
+	if (CRTC_PalettedFast)
+	{
+		switch (CRTC_InternalState.CRTC_RenderType)
+		{
+			case CRTC_RENDER_GRAPHICS:
+			{
+				unsigned short LocalMA, Addr;
+				if (CRTC_RenderMode == RENDER_MODE_ASIC_FEATURES)
+				{
+					/* CRTC_GetGraphicsDataPLUS_Paletted */
+					int c;
+					LocalMA = (unsigned short)(ASICCRTC_MALine + CRTC_InternalState.HCount);
+					Addr = (unsigned short)(((LocalMA & 0x03000)<<2) | ((LocalMA & 0x03ff)<<1));
+					Addr |= ASIC_RasterMA;
+					CRTC_InternalState.GraphicsLong = (CRTC_InternalState.GraphicsLong<<16) |
+						((Z80MemoryBase[(unsigned long)(Addr)])<<8) | (Z80MemoryBase[(unsigned long)(Addr+1)]);
+					if (!ASIC_ColMaskValid) ASIC_BuildColMask();
+					c = CRTC_InternalState.HCount & 0x03f;
+#ifdef NO_C
+					if (1)
+#else
+					if (ASIC_ColMask[c >> 5] & (1UL << (c & 31)))
+#endif
+					{
+						/* a sprite may be here: the full path */
+						unsigned long Mask = ASIC_BuildDisplayReturnMaskWithPixels(ASICCRTC_Line, CRTC_InternalState.HCount, CRTC_InternalState.Pixels);
+						Render_Paletted_PutDataWordPLUS(CRTC_InternalState.Monitor_State.MonitorHorizontalCount, CRTC_InternalState.GraphicsLong, CRTC_InternalState.Monitor_State.MonitorScanLineCount, Mask, CRTC_InternalState.Pixels);
+					}
+					else
+					{
+						unsigned Data = (unsigned)CRTC_InternalState.GraphicsLong >> ModeHorizontalPixelScroll;
+						CRTC_FastPutByte((Data & 0x0ff00) >> 8);
+						CRTC_FastPutByte(Data & 0x0ff);
+					}
+				}
+				else
+				{
+					/* CRTC_GetGraphicsDataCPC_Paletted */
+					LocalMA = (unsigned short)(CRTC_InternalState.MALine + CRTC_InternalState.HCount);
+					Addr = (unsigned short)(((LocalMA & 0x03000)<<2) | ((LocalMA & 0x03ff)<<1));
+					Addr |= CRTC_InternalState.RasterMA;
+					CRTC_FastPutByte(Z80MemoryBase[(unsigned long)(Addr)]);
+					CRTC_FastPutByte(Z80MemoryBase[(unsigned long)(Addr+1)]);
+				}
+			}
+			return;
+
+			case CRTC_RENDER_BORDER:
+			{
+				/* Render_Paletted_PutBorder: cell = first byte of ConvertedColourTable[16],
+				 * the 3 bytes after the cell = its bytes 1-3 */
+				unsigned v = ConvertedColourTable[16];
+				const unsigned char *cb = (const unsigned char *)&v;
+				unsigned int fill = (unsigned int)cb[0] * 0x01010101U;
+				unsigned int *d = (unsigned int *)pScreenLine;
+				d[0] = fill; d[1] = fill;
+				if (PIXEL_STEP == 1) { d[2] = fill; d[3] = fill; }
+				pScreenLine += Render_CellBytes;
+				pScreenLine[0] = cb[1]; pScreenLine[1] = cb[2]; pScreenLine[2] = cb[3];
+			}
+			return;
+
+			case CRTC_RENDER_SYNC:
+			{
+				unsigned int fill = (unsigned int)(unsigned char)Render_PaletteIndexBlack * 0x01010101U;
+				unsigned int *d = (unsigned int *)pScreenLine;
+				d[0] = fill; d[1] = fill;
+				if (PIXEL_STEP == 1) { d[2] = fill; d[3] = fill; }
+				pScreenLine += Render_CellBytes;
+			}
+			return;
+		}
+	}
+#endif
+
 	switch (CRTC_InternalState.CRTC_RenderType)
 	{
 		case CRTC_RENDER_GRAPHICS:
