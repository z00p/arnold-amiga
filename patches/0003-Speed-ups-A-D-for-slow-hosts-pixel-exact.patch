+#ifndef NO_A   /* diagnostic switches NO_A..NO_D turn each speed-up off */
+	if (Render_SkipCellIfHidden())
+	{
+		if (CRTC_RenderMode == RENDER_MODE_ASIC_FEATURES &&
+			(CRTC_InternalState.CRTC_Flags & (CRTC_HDISP_FLAG | CRTC_VDISP_FLAG | CRTC_R8DT_FLAG)) == (CRTC_HDISP_FLAG | CRTC_VDISP_FLAG) &&
+			!((CRTC_InternalState.Monitor_State.MonitorFlags & MONITOR_IN_VSYNC) || (CRTC_InternalState.CRTC_Flags & CRTC_HS_FLAG) || ASICCRTC_BlackDisplay))
+		{
+			unsigned short LocalMA = (unsigned short)(ASICCRTC_MALine + CRTC_InternalState.HCount);
+			unsigned short Addr = (unsigned short)(((LocalMA & 0x03000)<<2) | ((LocalMA & 0x03ff)<<1));
+			Addr |= ASIC_RasterMA;
