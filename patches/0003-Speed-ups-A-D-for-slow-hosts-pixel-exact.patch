@@ -57,6 +57,36 @@
 
 
 static ASIC_DATA ASIC_Data;
+/* Amiga port: C. Bit c set = some sprite active on this line covers CRTC column
+ * c (0-63). Rebuilt lazily after anything it depends on changes (enable masks,
+ * sprite position/size); lets ASIC_BuildDisplayReturnMaskWithPixels skip the
+ * 16-sprite loop for the columns no sprite touches. */
+unsigned long ASIC_ColMask[2];
+int ASIC_ColMaskValid = 0;
+
+/* rebuild ASIC_ColMask from the sprites active on this line (none: all zero) */
+void ASIC_BuildColMask(void)
+{
+	/* The sprite loop only runs if (EnableMask & OnLine) != 0, but then draws
+	 * every sprite in OnLine (13 Oct 2026: using Enable & OnLine here missed
+	 * sprites and changed 4 pixels in Pang). */
+	unsigned long Active = (ASIC_Data.SpriteEnableMask & ASIC_Data.SpriteEnableMaskOnLine) ?
+		ASIC_Data.SpriteEnableMaskOnLine : 0;
+	int s, d;
+	ASIC_ColMask[0] = ASIC_ColMask[1] = 0;
+	for (s = 0; s < 16; s++)
+		if (Active & (1UL << s))
+		{
+			unsigned long w = ASIC_Data.SpriteInfo[s].WidthInColumns;
+			if (w > 64) w = 64;
+			for (d = 0; d < (int)w; d++)
+			{
+				int c = (int)((ASIC_Data.SpriteInfo[s].MinColumn + d) & 0x03f);
+				ASIC_ColMask[c >> 5] |= 1UL << (c & 31);
+			}
+		}
+	ASIC_ColMaskValid = 1;
+}
 
 static void    ASIC_TriggerInterrupt(void);
 void    ASIC_DMA_DisableChannels(unsigned char Data);
@@ -445,6 +475,7 @@ void    ASIC_Reset(void)
         }
 
         ASIC_Data.SpriteEnableMask = 0;
+		ASIC_ColMaskValid = 0;
 
