+/* one graphics byte through the remapped-pixel cache, at the draw pointer */
+#define CRTC_FastPutByte(Byte)														{																					const RENDER_PIXCACHE *e_ = &pPixCache[Byte];									if (e_->Stamp != Render_RemapStamp) e_ = Render_CachedPixels(Byte);			((unsigned int *)pScreenLine)[0] = e_->u.l[0];									if (PIXEL_STEP == 1) ((unsigned int *)pScreenLine)[1] = e_->u.l[1];			pScreenLine += Render_CellBytes >> 1;										}
+
+/* Same test as Render_SkipCellIfHidden (render5.c), inline: it runs once per
+ * microsecond of CPC time. */
+extern unsigned char *pScreenLine, *pRowStart;
+extern int RenderRowVisible, Render_VisX0, Render_VisX1, Render_CellBytes;
+static __inline__ int Render_SkipCellIfHidden(void)
+{
+	int col = (int)(pScreenLine - pRowStart);
+	if (RenderRowVisible && col + Render_CellBytes >= Render_VisX0 && col < Render_VisX1)
+		return 0;
+	pScreenLine += Render_CellBytes;
+	return 1;
+}
