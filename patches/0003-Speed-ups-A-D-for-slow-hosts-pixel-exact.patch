+	if ((ASIC_Data.SpriteEnableMask & ASIC_Data.SpriteEnableMaskOnLine)!=0)
+	{
+		/* Amiga port: no sprite covers this column: same result as the loop */
+#ifndef NO_C
+		if (!ASIC_ColMaskValid) ASIC_BuildColMask();
+		{
+			int c = HCount & 0x03f;
+			if ((ASIC_ColMask[c >> 5] & (1UL << (c & 31))) == 0)
+				return 0x0ffff;
+		}
+#endif
+	}
+
 	if ((ASIC_Data.SpriteEnableMask & ASIC_Data.SpriteEnableMaskOnLine)!=0)
 	{
 		int     i;
@@ -1237,6 +1281,7 @@ static void ASIC_SetupSpriteRenderInfo(int SpriteIndex)
 
 				pRenderInfo->WidthInColumns = ((pRenderInfo->x & 0x0f) + 15 + (1<<(XMag-1+4)))>>4;
 				pRenderInfo->MinColumn = (pRenderInfo->x>>4) & 0x03f;
