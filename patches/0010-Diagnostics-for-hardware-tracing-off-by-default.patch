From e49e6248977d00d4baa8c82d243fb5d155dbecba Mon Sep 17 00:00:00 2001
From: John Stringer <jcec_1@yahoo.co.uk>
Date: Mon, 26 Oct 2026 07:40:34 +0000
Subject: [PATCH 10/37] Diagnostics for hardware tracing (off by default)

TRACE_HW: per-line trace of CRTC, Gate Array and ASIC writes for a chosen
frame (used with the headless host's TRACE_AT); PAL_COUNT: palette entries in
use. Both compile to nothing unless defined.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/cpc/asic.c    |  6 ++++++
 src/cpc/crtc.c    | 29 +++++++++++++++++++++++++++++
 src/cpc/garray.c  |  4 ++++
 src/cpc/render5.c | 13 +++++++++++++
 4 files changed, 52 insertions(+)

diff --git a/src/cpc/asic.c b/src/cpc/asic.c
index b90e67a..9305f3d 100644
--- a/src/cpc/asic.c
+++ b/src/cpc/asic.c
@@ -1097,6 +1097,9 @@ void    ASIC_HSync(int CRTC_LineCounter, int CRTC_RasterCounter)
                         (CRTC_RasterCounter == (ASIC_Data.ASIC_RasterInterruptLine & 0x07)))
                 {
                         /* raster interrupt occured */
+#ifdef TRACE_HW
+                        { extern void Trace_Hw(const char *, int, int); Trace_Hw("PRI fires", ASIC_Data.ASIC_RasterInterruptLine, 0); }
+#endif
                         ASIC_SetRasterInterrupt();
                 }
         }
@@ -1368,6 +1371,9 @@ unsigned char ASIC_GetSpriteMagnification(int SpriteIndex)
 /* data will have already been poked into ram */
 void    ASIC_WriteRam(int Addr,int Data)
 {
+#ifdef TRACE_HW
+	{ extern void Trace_Hw(const char *, int, int); if ((Addr & 0x3fff) >= 0x2800) Trace_Hw("ASIC", Addr, Data); }
+#endif
         if ((Addr & 0x0c000)!=0x04000)
                 return;
        
diff --git a/src/cpc/crtc.c b/src/cpc/crtc.c
index 6fd10d9..d32d2b1 100644
--- a/src/cpc/crtc.c
+++ b/src/cpc/crtc.c
@@ -1,3 +1,7 @@
+#include <stdio.h>
+#ifdef TRACE_HW
+void Trace_Hw(const char *what, int a, int b);
+#endif
 /*
  *  Arnold emulator (c) Copyright, Kevin Thacker 1995-2001
  *
@@ -1381,9 +1385,28 @@ static void             CRTC_DoLineChecksCRTC2(void)
 }
 
 
+#ifdef TRACE_HW
+int Trace_On;   /* headless sets it for the frames to trace */
+void Trace_Regs(void)
+{
+	int i;
+	{ extern unsigned char Trace_GaRmr(void); fprintf(stderr, "GA RMR %02x (mode %d)\n", Trace_GaRmr(), Trace_GaRmr() & 3); }
+	fprintf(stderr, "CRTC regs:");
+	for (i = 0; i < 16; i++) fprintf(stderr, " R%d=%02x", i, CRTCRegisters[i]);
+	fprintf(stderr, "\n");
+}
+void Trace_Hw(const char *what, int a, int b)
+{
+	if (Trace_On) fprintf(stderr, "L%03d H%02d VCC%02d RA%d %s %02x %02x\n", (int)CRTC_InternalState.Monitor_State.MonitorScanLineCount,
+		(int)CRTC_InternalState.HCount, (int)CRTC_InternalState.LineCounter, (int)CRTC_InternalState.RasterCounter, what, a & 0xffff, b & 0xff);
+}
+#endif
 void    CRTC_WriteData(unsigned int Data)
 {
 	     int CRTC_RegIndex = CRTC_InternalState.CRTC_Reg & 0x1f;
+#ifdef TRACE_HW
+	Trace_Hw("CRTC", CRTC_RegIndex, Data);
+#endif
 
 
         /* store in backup set, used to change CRTC type */
@@ -1963,6 +1986,9 @@ void ASICCRTC_ScreenSplit(void)
 				*/
                 if (ASIC_DoScreenSplit == TRUE)
                 {
+#ifdef TRACE_HW
+                        Trace_Hw("SPLIT applied, SSA", ASIC_GetSSA(), 0);
+#endif
                         ASIC_DoScreenSplit = FALSE;
 
                         CRTC_InternalState.MA = ASIC_GetSSA();
@@ -1980,6 +2006,9 @@ void ASICCRTC_ScreenSplit(void)
 
                 if (ASIC_RasterSplitLineMatch(CRTC_InternalState.LineCounter, CRTC_InternalState.RasterCounter))
                 {
+#ifdef TRACE_HW
+                        Trace_Hw("SPLIT match", CRTC_InternalState.LineCounter, CRTC_InternalState.RasterCounter);
+#endif
                         if (!(CRTC_InternalState.CRTC_Flags & CRTC_VTOT_FLAG))
                         {
 /*                              if (!ASIC_RasterLineMatch) */
diff --git a/src/cpc/garray.c b/src/cpc/garray.c
index 42e2844..a2e513a 100644
--- a/src/cpc/garray.c
+++ b/src/cpc/garray.c
@@ -38,6 +38,7 @@ unsigned char   *pReadRamPtr[8];
 unsigned char   *pWriteRamPtr[8];
 
 GATE_ARRAY_STATE	GateArray_State;
+unsigned char Trace_GaRmr(void) { return GateArray_State.RomConfiguration; }
 /* actual colours to display */
 RGBCOLOUR       DisplayColours[32];
 
@@ -576,6 +577,9 @@ void	GateArray_Update(void)
 
 void    GateArray_Write(int Function)
 {
+#ifdef TRACE_HW
+	{ extern void Trace_Hw(const char *, int, int); if ((Function & 0xc0) == 0x80 || (Function & 0xc0) == 0xc0) Trace_Hw("GA", Function & 0xc0, Function); }
+#endif
     switch (Function & 0x0c0)
     {
 		case 0x000:
diff --git a/src/cpc/render5.c b/src/cpc/render5.c
index d74ac12..0a0a434 100644
--- a/src/cpc/render5.c
+++ b/src/cpc/render5.c
@@ -1,3 +1,4 @@
+#include <stdio.h>
 /* 
  *  Arnold emulator (c) Copyright, Kevin Thacker 1995-2001
  *  
@@ -1567,9 +1568,21 @@ void    Render_ClearDisplay(void)
         }
 }
 
+#ifdef PAL_COUNT
+int Render_PaletteUsedCount(void)
+{
+	int i, n = 0;
+	for (i = 0; i < 256; i++) if (CPCPalette[i].Flags & PALETTE_ENTRY_USED) n++;
+	return n;
+}
+#endif
+
 void    Render_DumpDisplay(void)
 {
         pRender_DumpScreen();
+#ifdef PAL_COUNT
+	{ static int f; if (++f % 100 == 0) fprintf(stderr, "frame %d palette entries used %d\n", f, Render_PaletteUsedCount()); }
+#endif
 
 /*		Palette_Set();
 
