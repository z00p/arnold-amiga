--- a/src/cpc/z80/z80.c
+++ b/src/cpc/z80/z80.c
@@ -24,6 +24,31 @@
 Z80_REGISTERS R;
 #include "z80funcs.h"
 #include "z80funcs2.h"
+
+/* Amiga port: data memory access inline (the out-of-line Z80_RD_MEM /
+ * Z80_WR_MEM calls cost a call per data access; same arithmetic as cpc.c).
+ * Writes take the function pointer unless it is plain CPC_WriteMemory (ASIC
+ * RAM paged in uses CPCPlus_WriteMemoryWithASICRamEnabled). */
+extern unsigned char *pReadRamPtr[8];
+extern unsigned char *pWriteRamPtr[8];
+extern void (*pWriteMemory)(Z80_WORD Addr, Z80_BYTE Data);
+void CPC_WriteMemory(Z80_WORD Addr, Z80_BYTE Data);
+static __inline__ Z80_BYTE Z80_RD_MEM_Inline(Z80_WORD Addr)
+{
+	return pReadRamPtr[Addr >> 13][Addr];
+}
+static __inline__ void Z80_WR_MEM_Inline(Z80_WORD Addr, Z80_BYTE Data)
+{
+	if (pWriteMemory == CPC_WriteMemory)
+		pWriteRamPtr[(Addr >> 13) & 0x07][Addr] = Data;
+	else
+		pWriteMemory(Addr, Data);
+}
+#undef Z80_RD_MEM
+#undef Z80_WR_MEM
+#define Z80_RD_MEM(Addr) Z80_RD_MEM_Inline((Z80_WORD)(Addr))
+#define Z80_WR_MEM(Addr, Data) Z80_WR_MEM_Inline((Z80_WORD)(Addr), (Z80_BYTE)(Data))
+
 /***************************************************************************/
 INLINE static int Z80_FD_CB_ExecuteInstruction(void)
 {
