index d2396e7..fb46b91 100644
--- a/src/cpc/cpc.c
+++ b/src/cpc/cpc.c
@@ -107,7 +107,8 @@ void CPC_InstallWritePort(CPCPortWrite *writePort)
 	NumWritePorts++;
 }
 
-static unsigned long   NopCount = 0;
