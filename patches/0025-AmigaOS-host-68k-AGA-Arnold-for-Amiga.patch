+	sprintf(t, "SKIP%d%s%s%s", Sys_OsdSkip, Sys_SafeFlip ? " SAFEFLIP" : "", Sys_AllLines ? " ALLLINES" : "", Sys_PalAll ? " PALALL" : "");
+	InitRastPort(&rp);
