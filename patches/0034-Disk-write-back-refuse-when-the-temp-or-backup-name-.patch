From d9b230015d3bbc7be84b9734067f9f3865b77d8c Mon Sep 17 00:00:00 2001
From: John Stringer <jcec_1@yahoo.co.uk>
Date: Tue, 27 Oct 2026 07:56:58 +0000
Subject: [PATCH 34/39] Disk write-back: refuse when the temp or backup name
 would clash

The write-back uses <name>.tmp, <name>.bak and <name>.old. A volume that cuts
file names to 30 characters (OFS/FFS of older Kickstarts) makes these one file
for a 29-character name, and .tmp the image itself for a 30-character one: the
write was lost, or the disk file deleted. Two new host hooks, Host_SameFile
(the same file, e.g. SameLock) and Host_NameKept (stored under the full name),
let DskWrite_SaveFile refuse before anything is removed or renamed; the
changes stay in the drive and the host is told why.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/cpc/diskimage/dskwrite.c | 28 ++++++++++++++++++++++++++++
 src/cpc/diskimage/dskwrite.h |  5 +++++
 2 files changed, 33 insertions(+)

diff --git a/src/cpc/diskimage/dskwrite.c b/src/cpc/diskimage/dskwrite.c
index 95e77a9..6d167ed 100644
--- a/src/cpc/diskimage/dskwrite.c
+++ b/src/cpc/diskimage/dskwrite.c
@@ -33,6 +33,7 @@
 #include "diskimg.h"
 #include "iextdsk.h"
 #include "dskwrite.h"
+#define DSKWRITE_CLASH "disk name too long for this volume: changes kept in memory"
 
 extern BOOL DiskImage_GetUnitPointer(int DriveID, DISKIMAGE_UNIT **ppUnit);
 
@@ -294,6 +295,22 @@ static int file_exists(const char *n)
 	return 1;
 }
 
+/* The temp, backup and old names must not be the image, each other, or a name
+ * the volume stored cut short. A name that exists is checked now (Host_SameFile
+ * / Host_NameKept); one that does not exist yet is checked again after the temp
+ * file is created. 1 = refuse. */
+static int name_clash(const char *name, const char *tmp, const char *bak, const char *old)
+{
+	const char *x[3]; int i, j;
+	x[0] = tmp; x[1] = bak; x[2] = old;
+	for (i = 0; i < 3; i++) {
+		if (Host_SameFile(name, x[i])) return 1;
+		if (file_exists(x[i]) && !Host_NameKept(x[i])) return 1;
+		for (j = 0; j < i; j++) if (Host_SameFile(x[j], x[i])) return 1;
+	}
+	return 0;
+}
+
 int DskWrite_SaveFile(const char *name, const unsigned char *buf, unsigned long len, int *made_bak, char *why)
 {
 	char tmp[DSKWRITE_PATH + 8], bak[DSKWRITE_PATH + 8], old[DSKWRITE_PATH + 8];
@@ -306,12 +323,23 @@ int DskWrite_SaveFile(const char *name, const unsigned char *buf, unsigned long
 	if (!Host_FileWritable(name)) { strcpy(why, "the file or disk is write-protected"); return 0; }
 	sprintf(tmp, "%s.tmp", name); sprintf(bak, "%s.bak", name); sprintf(old, "%s.old", name);
 
+	/* 0. the four names must be four different files (N1 of the code review).
+	 * A volume that cuts names to 30 characters (OFS/FFS of older Kickstarts) makes
+	 * .tmp/.bak/.old one file for a 29-character name and .tmp the image itself
+	 * for a 30-character one. Nothing is removed or renamed until this is clear. */
+	if (name_clash(name, tmp, bak, old)) { strcpy(why, DSKWRITE_CLASH); return 0; }
+
 	/* 1. the new image into <name>.tmp, checked */
 	remove(tmp);
 	f = fopen(tmp, "wb");
 	if (!f) { strcpy(why, "can't create the temp file (write-protected or name too long?)"); return 0; }
 	ok = fwrite(buf, 1, len, f) == len;
 	if (fclose(f) != 0) ok = 0;
+	/* the temp file we just made must be stored under the name we gave it (and not be the image) */
+	if (ok && (Host_SameFile(name, tmp) || !Host_NameKept(tmp))) {
+		if (!Host_SameFile(name, tmp)) remove(tmp);   /* ours (the name did not exist before) */
+		strcpy(why, DSKWRITE_CLASH); return 0;
+	}
 	if (ok) {
 		f = fopen(tmp, "rb");
 		ok = f && fseek(f, 0, SEEK_END) == 0 && ftell(f) == (long)len;
diff --git a/src/cpc/diskimage/dskwrite.h b/src/cpc/diskimage/dskwrite.h
index 8e08a20..2087604 100644
--- a/src/cpc/diskimage/dskwrite.h
+++ b/src/cpc/diskimage/dskwrite.h
@@ -24,5 +24,10 @@ int  DskWrite_Flush(int drive, const char *name, unsigned char **pimg, unsigned
 
 /* the host: 0 if the file or its volume is write-protected */
 int  Host_FileWritable(const char *name);
+/* 1 if both names exist and are the very same file (SameLock on the Amiga) */
+int  Host_SameFile(const char *a, const char *b);
+/* 0 if the file exists but the volume stored it under a shorter name than
+ * asked for (names cut to 30 characters); 1 if fine or if it does not exist */
+int  Host_NameKept(const char *name);
 
 #endif
-- 
