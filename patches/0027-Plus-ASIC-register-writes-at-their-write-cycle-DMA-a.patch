From 22f63a658441126a154603413c19d515b96a37d5 Mon Sep 17 00:00:00 2001
From: John Stringer <jcec_1@yahoo.co.uk>
Date: Tue, 27 Oct 2026 07:56:55 +0000
Subject: [PATCH 27/39] Plus: ASIC register writes at their write cycle, DMA at
 HSYNC start

Memory-mapped ASIC writes (&6000-&7FFF and sprite pixels &4000-&4FFF) now
take effect at the instruction's memory-write NOP (Z80_WriteNop, CPCEC's
positions; PUSH writes the high byte first) instead of its start, like the
CRTC writes. The Plus DMA runs at the start of HSYNC with its interrupt
DMAPHASE_DELAY cycles later, not at the end of HSYNC: Sonic GX's interrupt
code ran about 10 characters late against the beam. NO_ASICTIME,
NO_ASICTIME_SPR, NO_DMAPHASE restore the old timing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/cpc/asic.c          | 58 +++++++++++++++++++++++++++++++++-
 src/cpc/asic.h          | 10 ++++++
 src/cpc/cpc.c           | 21 +++++++++++++
 src/cpc/crtc.c          |  7 +++++
 src/cpc/z80/z80.c       | 69 +++++++++++++++++++++++++++++++++++++++++
 src/cpc/z80/z80.h       |  3 ++
 src/cpc/z80/z80macros.h |  6 ++++
 7 files changed, 173 insertions(+), 1 deletion(-)

diff --git a/src/cpc/asic.c b/src/cpc/asic.c
index bd0c155..d30322f 100644
--- a/src/cpc/asic.c
+++ b/src/cpc/asic.c
@@ -62,6 +62,32 @@ static ASIC_DATA ASIC_Data;
 struct { int Done; int Delay[3]; } ASIC_DMA_Stagger;
 int ASIC_DMA_IntPending;
 #endif
+#ifndef NO_DMAPHASE
+/* Amiga port (asictime, 21 Oct 2026): DMA timing. Arnold ran the DMA channels
+ * at the END of HSYNC (12-14 us after its start with the usual HSYNC); the
+ * ASIC (and CPCEC) runs them 2-3 us after HSYNC starts. Code driven by DMA
+ * interrupts (Sonic GX: split, scroll and palette writes) ran up to 10 us later
+ * relative to the beam than in CPCEC. Now the channels run at the HSYNC-start
+ * event (ASIC_HSyncStart) and their INT is raised DMAPHASE_DELAY cycles later
+ * through the stagger countdown (ASIC_DMA_Tick), which matches CPCEC's write
+ * positions in traces. A DCSR write that enables a channel within those
+ * cycles runs it at once (Sonic's special stage enables its channels one cycle
+ * after HSYNC starts; CPCEC reads DCSR at its DMA cycle). An extra CRTC event
+ * at the DMA cycle cost 1 ms a frame on Emu68, so there is none.
+ * NO_DMAPHASE: at the end of HSYNC, as before. */
+void    ASIC_DMA_HandleChannel(int ChannelIndex);
+static int ASIC_DMA_PhaseBase;     /* cycles to add to a DMA INT raised now */
+static void ASIC_DMA_RunChannels(int Mask, int Base)
+{
+	int i;
+	ASIC_DMA_Stagger.Done = 0;
+	ASIC_DMA_PhaseBase = Base;
+	for (i = 0; i < 3; i++)
+		if (Mask & (1 << i))
+			ASIC_DMA_HandleChannel(i);
+	ASIC_DMA_PhaseBase = 0;
+}
+#endif
 /* Amiga port: C. Bit c set = some sprite active on this line covers CRTC column
  * c (0-63). Rebuilt lazily after anything it depends on changes (enable masks,
  * sprite position/size); lets ASIC_BuildDisplayReturnMaskWithPixels skip the
@@ -1256,9 +1282,15 @@ void    ASIC_HSyncStart(int CRTC_LineCounter, int CRTC_RasterCounter)
 		ASIC_SetRasterInterrupt();
 		ASIC_TriggerInterrupt();
 	}
+#ifndef NO_DMAPHASE
+	if (ASIC_Data.InternalDCSR & 0x07)
+	{
+		ASIC_DMA_RunChannels(ASIC_Data.InternalDCSR & 0x07, DMAPHASE_DELAY);
+		ASIC_TriggerInterrupt();
+	}
+#endif
 }
 #endif
-
 void    ASIC_HSync(int CRTC_LineCounter, int CRTC_RasterCounter)
 {
         /* if ASIC is not enabled, then functions not
@@ -1283,7 +1315,9 @@ void    ASIC_HSync(int CRTC_LineCounter, int CRTC_RasterCounter)
 #endif
 
         /* do a dma cycle and maybe set a dma interrupt */
+#ifdef NO_DMAPHASE
         ASIC_DoDMA();
+#endif
 
         /* trigger int if any sources require an interrupt */
         ASIC_TriggerInterrupt();
@@ -1825,6 +1859,18 @@ void    ASIC_WriteRam(int Addr,int Data)
                         ASIC_DMA_DisableChannels((unsigned char)Data);
                 }
 
+#ifndef NO_DMAPHASE
+                /* asictime: a channel enabled within DMAPHASE_DELAY cycles of the
+                 * HSYNC start still runs on this line (its INT at the usual cycle) */
+                {
+                        int hc = CRTC_HSyncCount(), New = Data & 0x07 & ~ASIC_Data.InternalDCSR;
+                        if (New && hc >= 0 && hc < DMAPHASE_DELAY)
+                        {
+                                ASIC_Data.InternalDCSR |= New;   /* HandleChannel needs it set */
+                                ASIC_DMA_RunChannels(New, DMAPHASE_DELAY - hc);
+                        }
+                }
+#endif
                 /* keep info about channels enabled and the channels interrupting */
 #ifndef NO_IVEC_FIX
                 /* Amiga port (18 Oct 2026): a DCSR write does not cancel a
@@ -1968,6 +2014,9 @@ void    ASIC_DMA_ExecuteCommand(int ChannelIndex)
         Addr = ASIC_Data.DMA[ChannelIndex].Addr.Addr_W;
 		
         Command = ASIC_DMA_GetOpcode((Z80_WORD)(Addr & 0x0fffe));
+#ifdef TRACE_HW
+	{ extern void Trace_Hw(const char *, int, int); Trace_Hw(ChannelIndex == 0 ? "DMA0 cmd" : ChannelIndex == 1 ? "DMA1 cmd" : "DMA2 cmd", Addr, Command >> 8); }
+#endif
         
         CommandOpcode = (Command & 0x07000)>>12;
 
@@ -2061,10 +2110,17 @@ void    ASIC_DMA_ExecuteCommand(int ChannelIndex)
 
                                 /* set channel interrupt */
 #ifndef NO_DMA_STAGGER
+#ifndef NO_DMAPHASE
+                                if (ASIC_DMA_Stagger.Done + ASIC_DMA_PhaseBase != 0)
+                                {
+                                        /* raised later (see ASIC_DMA_Tick) */
+                                        ASIC_DMA_Stagger.Delay[ChannelIndex] = ASIC_DMA_Stagger.Done + ASIC_DMA_PhaseBase;
+#else
                                 if (ASIC_DMA_Stagger.Done != 0)
                                 {
                                         /* raised later (see ASIC_DMA_Tick) */
                                         ASIC_DMA_Stagger.Delay[ChannelIndex] = ASIC_DMA_Stagger.Done;
+#endif
                                         ASIC_DMA_IntPending = 1;
                                 }
                                 else
diff --git a/src/cpc/asic.h b/src/cpc/asic.h
index 6566eb3..7367c69 100644
--- a/src/cpc/asic.h
+++ b/src/cpc/asic.h
@@ -52,6 +52,16 @@ unsigned char *ASIC_GetRamPtr(void);
 unsigned long ASIC_BuildDisplayReturnMaskWithPixels(int Line, int HCount, /*int MonitorHorizontalCount, int ActualY,*/ int *pPixels);
 
 void    ASIC_DoDMA(void);
+#if (defined(NO_PRI_FIX) || defined(NO_DMA_STAGGER)) && !defined(NO_DMAPHASE)
+#define NO_DMAPHASE   /* needs the HSYNC-start hook and the stagger countdown */
+#endif
+#ifndef NO_DMAPHASE
+/* asictime: DMA interrupts are raised this many cycles after HSYNC starts (asic.c) */
+#ifndef DMAPHASE_DELAY
+#define DMAPHASE_DELAY 2
+#endif
+int     CRTC_HSyncCount(void);
+#endif
 #ifndef NO_DMA_STAGGER
 /* Amiga port: DMA interrupts raised a microsecond per lower channel later */
 extern int ASIC_DMA_IntPending;
diff --git a/src/cpc/cpc.c b/src/cpc/cpc.c
index e891f71..d2396e7 100644
--- a/src/cpc/cpc.c
+++ b/src/cpc/cpc.c
@@ -2285,8 +2285,26 @@ void CPC_WriteMemory(Z80_WORD Addr,Z80_BYTE Data)
 }
 
 /* write a byte to emulator memory with paging */
+#ifndef NO_ASICTIME
+/* Amiga port (asictime, 21 Oct 2026): a write to the ASIC page takes effect at
+ * its memory-write cycle (z80.c Z80_WriteNop, CPCEC's timing), not at the start
+ * of the instruction: the CRTC/ASIC is run up to that NOP first (arnold.c
+ * CPC_IOCatchUp, as for OUT to the CRTC). Registers &6000-&7FFF; sprite pixels
+ * &4000-&4FFF too unless NO_ASICTIME_SPR. NO_ASICTIME: at the start, as before. */
+int Z80_WriteNop(Z80_WORD Addr);
+extern int CPC_IOPre;
+void CPC_IOCatchUp(void);
+#ifdef NO_ASICTIME_SPR
+#define ASICTIME_ADDR(a) (((a) & 0x0e000) == 0x06000)
+#else
+#define ASICTIME_ADDR(a) (((a) & 0x0e000) == 0x06000 || ((a) & 0x0f000) == 0x04000)
+#endif
+#endif
 void CPCPlus_WriteMemoryWithASICRamEnabled(Z80_WORD Addr,Z80_BYTE Data)
 {
+#ifndef NO_ASICTIME
+	if (ASICTIME_ADDR(Addr)) { CPC_IOPre = Z80_WriteNop(Addr); CPC_IOCatchUp(); }
+#endif
 	/* Amiga port: ASIC registers (&6000-&7FFF: sprite position/size, palette,
 	 * split, scroll, DMA) may change what the CRTC draws next; sprite pixel
 	 * data (&4000-&4FFF) is read live by the sprite path. */
@@ -3161,6 +3179,9 @@ void    Z80_AcknowledgeInterrupt(void)
         }
 #endif
 
+#ifdef TRACE_HW
+        { extern void Trace_Hw(const char *, int, int); Trace_Hw("INT ack, vector", PlusVector, 0); }
+#endif
         Z80_ClearInterruptRequest();
 #ifndef NO_INTHOLD_FIX
         /* Amiga port (19 Oct 2026): the ASIC holds the Z80's INT line while
diff --git a/src/cpc/crtc.c b/src/cpc/crtc.c
index 097b512..47a527b 100644
--- a/src/cpc/crtc.c
+++ b/src/cpc/crtc.c
@@ -4290,6 +4290,13 @@ int CRTC_CyclesToEvent(void)
 #endif
 }
 
+#ifndef NO_DMAPHASE
+/* asictime (asic.c): cycles since HSYNC started, -1 outside HSYNC */
+int CRTC_HSyncCount(void)
+{
+	return (CRTC_InternalState.CRTC_Flags & CRTC_HS_FLAG) ? (int)CRTC_InternalState.HorizontalSyncCount : -1;
+}
+#endif
 void CRTC_DoCycles(int Cycles)
 {
 /* Amiga port (19 Oct 2026): count down staggered DMA interrupts (asic.c
diff --git a/src/cpc/z80/z80.c b/src/cpc/z80/z80.c
index 9eda75a..5889e91 100644
--- a/src/cpc/z80/z80.c
+++ b/src/cpc/z80/z80.c
@@ -13735,3 +13735,72 @@ break;
 }
 return Cycles;
 }
+
+#ifndef NO_ASICTIME
+/* Amiga port (asictime, 21 Oct 2026): the NOP of the current instruction at
+ * which its memory write to Addr happens, for writes to the Plus ASIC page
+ * (cpc.c CPCPlus_WriteMemoryWithASICRamEnabled). Not on the hot path: it is
+ * called only for writes to &4000-&7FFF while the ASIC page is mapped in.
+ * R.PC still points at the instruction (the core adds to PC at its end).
+ * Values are CPCEC's (z80_delays: the NOPs that pass before its POKE).
+ * 0 = unknown (CALL/RST/interrupt pushes; CPCEC does not time those either):
+ * the write stays at the start of the instruction, as before. */
+int Z80_WriteNop(Z80_WORD Addr)
+{
+	unsigned int op = Z80_RD_OPCODE_BYTE(0), op2;
+	switch (op)
+	{
+	case 0x02: case 0x12:                         /* LD (BC),A / LD (DE),A */
+	case 0x70: case 0x71: case 0x72: case 0x73:   /* LD (HL),r */
+	case 0x74: case 0x75: case 0x77:
+		return 2;
+	case 0x34: case 0x35: case 0x36:              /* INC/DEC (HL), LD (HL),n */
+		return 3;
+	case 0x32:                                    /* LD (nn),A */
+		return 4;
+	case 0x22:                                    /* LD (nn),HL: low, then high */
+		return Addr == Z80_RD_OPCODE_WORD(1) ? 4 : 5;
+	case 0xc5: case 0xd5: case 0xe5: case 0xf5:   /* PUSH rr: high (SP+1), then low (SP) */
+		return Addr == (Z80_WORD)(R.SP.W + 1) ? 3 : 4;
+	case 0xe3:                                    /* EX (SP),HL: high (SP+1), then low (SP) */
+		return Addr == (Z80_WORD)(R.SP.W + 1) ? 5 : 6;
+	case 0xcb:                                    /* RLC..SET (HL); BIT does not write */
+		op2 = Z80_RD_OPCODE_BYTE(1);
+		return ((op2 & 7) == 6 && (op2 & 0xc0) != 0x40) ? 4 : 0;
+	case 0xed:
+		op2 = Z80_RD_OPCODE_BYTE(1);
+		switch (op2)
+		{
+		case 0x43: case 0x53: case 0x63: case 0x73:   /* LD (nn),rr */
+			return Addr == Z80_RD_OPCODE_WORD(2) ? 5 : 6;
+		case 0x67: case 0x6f:                         /* RRD / RLD */
+			return 5;
+		case 0xa0: case 0xa8: case 0xb0: case 0xb8:   /* LDI/LDD/LDIR/LDDR */
+			return 4;
+		case 0xa2: case 0xaa: case 0xb2: case 0xba:   /* INI/IND/INIR/INDR */
+			return 5;
+		}
+		return 0;
+	case 0xdd: case 0xfd:
+		op2 = Z80_RD_OPCODE_BYTE(1);
+		switch (op2)
+		{
+		case 0x70: case 0x71: case 0x72: case 0x73:   /* LD (IX+d),r */
+		case 0x74: case 0x75: case 0x77:
+			return 5;
+		case 0x34: case 0x35: case 0x36:              /* INC/DEC (IX+d), LD (IX+d),n */
+			return 6;
+		case 0x22:                                    /* LD (nn),IX */
+			return Addr == Z80_RD_OPCODE_WORD(2) ? 5 : 6;
+		case 0xe5:                                    /* PUSH IX */
+			return Addr == (Z80_WORD)(R.SP.W + 1) ? 4 : 5;
+		case 0xe3:                                    /* EX (SP),IX */
+			return Addr == (Z80_WORD)(R.SP.W + 1) ? 6 : 7;
+		case 0xcb:                                    /* RLC..SET (IX+d) */
+			return 7;
+		}
+		return 0;
+	}
+	return 0;
+}
+#endif
