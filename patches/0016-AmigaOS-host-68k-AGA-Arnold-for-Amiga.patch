+SOUND_PLAYBACK_FORMAT *Host_GetSoundPlaybackFormat(void) { return &sf; }
+BOOL Host_LockAudioBuffer(unsigned char **p1, unsigned long *l1, unsigned char **p2, unsigned long *l2, int size)
+{
