use_gui=no
kickstart_rom_file=.\roms\A1200.47.115.ROM
chipset=aga
chipset_compatible=A1200
cpu_24bit_addressing=false
chipmem_size=4
fastmem_size=0
z3mem_size=128
nr_floppies=1
floppy0type=0
filesystem2=rw,DH0:Workbench:.\wb,5
uaehf0=dir,rw,DH0:Workbench:.\wb,5
filesystem2=rw,DH9:Arnold:..\run,-128
uaehf1=dir,rw,DH9:Arnold:..\run,-128
gfx_fullscreen_amiga=false
gfx_width_windowed=1440
gfx_height_windowed=1080
gfx_linemode=double
input.magic_mouse=false
win32.start_not_captured=true
input.tablet=none
input.mouse_untrap=middlebutton
sound_output=exact
sound_channels=stereo
sound_stereo_separation=7
sound_frequency=48000
sound_volume=0
sound_auto=false
cpu_model=68060
fpu_model=68060
cpu_compatible=true
cpu_cycle_exact=true
cpu_memory_cycle_exact=true
cpu_speed=real
cpu_multiplier=14
cpu_data_cache=true
cachesize=0
warp=false
; Arnold rig: magic mouse OFF (with it on, WinUAE floods the emulation screen with
; cursor up/down key events, 13 Oct 2026). Port 1 mouse, port 2 the numeric keypad "joystick" (numpad 0 = fire).
; The PC has an XInput pad whose idle axes WinUAE otherwise reports as cursor keys.
joyport0=mouse
joyport1=kbd1
joyport0mode=mouse
joyport1mode=djoy
config_description=Arnold: 68060/50, cycle-exact mode (approximate 060 timing), no JIT; for speed estimates
